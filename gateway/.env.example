# Az RFID gateway beállításai.
#
# Másold `.env` néven ugyanebbe a mappába, és töltsd ki. A .env fájlt a git
# nem követi – a kulcs sosem kerül a repóba.
#
#   copy .env.example .env
#   notepad .env

# A Railway-en futó szerver címe. Záró perjel nélkül.
SERVER_URL=https://iroda-szerver.up.railway.app

# Ugyanaz az érték, mint a Railway `GATEWAY_API_KEY` változójában.
# Ha a kettő nem egyezik, a szerver 401-et ad, és a puffer korlátlanul nő.
# Új kulcs generálása:  python -c "import secrets; print(secrets.token_urlsafe(32))"
GATEWAY_API_KEY=

# Ez a név azonosítja a gateway-t az admin felületen.
GATEWAY_ID=iroda-fszt

# Üresen hagyva automatikusan keresi a portot (CH340 / FT232 / CP210x).
# Ha megadod, az mindig erősebb az automatikus keresésnél. Például: COM5
SERIAL_PORT=

# Az Arduino sketch 115200 baudon küld. Csak akkor írd át, ha a sketch is más.
BAUD_RATE=115200

# Az időbélyegek időzónája. A szerver ebből számol UTC-t.
TZ=Europe/Budapest

# Az adatbázis és a naplók helye. Üresen hagyva: C:\ProgramData\IrodaGateway
# Ne a Program Files alá tedd (jogosultság), és ne a felhasználói profilba
# (a szolgáltatás nem a te fiókoddal fut).
DATA_DIR=

# DEBUG esetén a percenkénti környezeti minták is a naplóba kerülnek.
LOG_LEVEL=INFO

# false esetén az ENV sorokat eldobja, nem gyűjt szenzoradatot.
ENV_ENABLED=true
