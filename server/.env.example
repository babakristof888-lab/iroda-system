# Lokális fejlesztéshez másold .env néven, és töltsd ki.
# Railway-en ugyanezeket a service Variables fülén kell beállítani
# (ott a DB_PATH /data/iroda.db legyen, a volume mountpointján).

# Az adatbázis helye. Railway-en: /data/iroda.db
DB_PATH=./dev.db

# A gateway ezzel a kulccsal hitelesít. Generálás:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
GATEWAY_API_KEY=valtoztasd-meg

# Az admin jelszó bcrypt hash-e. Generálás:
#   python scripts/hash_password.py
ADMIN_PASSWORD_HASH=

# Lokálisan http-n fejlesztünk, ezért a secure cookie-t ki kell kapcsolni.
# Railway-en (https) hagyd true értéken, vagy ne állítsd be.
COOKIE_SECURE=false

TZ=Europe/Budapest

# Üzleti beállítások
DEBOUNCE_SECONDS=60
AUTO_CLOSE_HOUR=23:59

# Környezeti riasztás küszöbei (csak a felületen jelenik meg, nincs értesítés)
TEMP_MIN_ALERT=16
TEMP_MAX_ALERT=28
HUM_MIN_ALERT=25
HUM_MAX_ALERT=65
ENV_ALERTS_ENABLED=true

# Bérszámítás. false esetén a bér-oszlopok, -nézetek és -exportok eltűnnek,
# a hozzájuk tartozó útvonalak pedig 404-et adnak.
SALARY_ENABLED=true

# ALAPÉRTELMEZETT órabér (Ft/óra). Csak arra a dolgozóra vonatkozik, akinek
# nincs saját sora az employee_rates táblában. A dolgozónkénti órabért az
# admin felületen kell felvenni: Dolgozók -> Órabér.
HOURLY_RATE=1900
